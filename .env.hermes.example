# Hermes Relay — canonical configuration for the Docker Compose deployment.
#
#   ./scripts/generate-env.sh      # creates .env.hermes with fresh secrets
#
# or copy this file to .env.hermes and fill in every REQUIRED value by hand.
# .env.hermes holds secrets: keep it chmod 600, never commit it (it is in
# .gitignore), and back it up with the same care as the keystore.
#
# Values must not be quoted — Docker env files pass quotes through literally.

# ─── REQUIRED: runtime mode ──────────────────────────────────────────────────
# "production" makes both services refuse to start without the secrets below
# and forbids ephemeral (per-process) gateway signing keys. Do not change.
HERMES_ENV=production

# ─── REQUIRED: secrets (generate each with: openssl rand -hex 32) ────────────
# HMAC key for the V1 attestation chain (hex). Changing it later makes the
# existing V1 chain fail verification.
HERMES_SIGNING_KEY=
# AES-256-GCM token vault key — exactly 64 hex characters.
HERMES_VAULT_KEY=
# Passphrase that decrypts the gateway signing keystore
# (/app/keys/gateway.keystore). Losing it makes the keystore unusable.
HERMES_GATEWAY_KEYSTORE_PASSPHRASE=

# ─── REQUIRED: administrative credentials ────────────────────────────────────
# X-Admin-Token for POST /v1/workspaces (workspace creation, API port 8787,
# reachable from the Docker host only) and POST /gateway/policy/reload.
HERMES_ADMIN_TOKEN=
# Legacy single-tenant X-API-Key accepted by /v1/scrub and /v1/review.
# Gateway clients do NOT use this; they use per-workspace keys.
HERMES_API_KEY=

# ─── REQUIRED: gateway policy ────────────────────────────────────────────────
# HIPAA_PRODUCTION_BLOCK: detected PHI → HTTP 403, request never forwarded.
# HIPAA_STRICT:           detected PHI → redacted, then forwarded.
HERMES_GATEWAY_POLICY=HIPAA_PRODUCTION_BLOCK

# ─── REQUIRED: provider credentials (at least one) ───────────────────────────
# The gateway injects these upstream and strips any client Authorization /
# x-api-key / api-key header. /gateway/health (and the gateway container
# health check) reports unhealthy until at least one is set.
HERMES_OPENAI_API_KEY=
HERMES_ANTHROPIC_API_KEY=
# Azure OpenAI needs both the key and the resource endpoint, e.g.
# https://<resource>.openai.azure.com
HERMES_AZURE_OPENAI_KEY=
HERMES_AZURE_OPENAI_ENDPOINT=

# ─── FIXED BY docker-compose.yml — do not set here ───────────────────────────
# Persistence and keystore paths are set in docker-compose.yml so the API and
# gateway always share the same files on the hermes_data / hermes_keys volumes:
#   HERMES_DATA_DIR=/app/data/workspaces
#   HERMES_REGISTRY_DB=/app/data/workspaces/registry.db
#   HERMES_DB_PATH=/app/data/hermes_chain.db
#   HERMES_VAULT_DB_PATH=/app/data/hermes_vault.db
#   HERMES_CANARY_DB_PATH=/app/data/hermes_canary.db
#   HERMES_GATEWAY_KEYSTORE_PATH=/app/keys/gateway.keystore
# The gateway's host bind address is HERMES_GATEWAY_BIND (default 127.0.0.1).
# It is read by Docker Compose from your shell or ./.env, NOT from this file.

# ─── OPTIONAL: evidence export (unset = disabled) ────────────────────────────
# Generic JSON webhook for receipts / gateway evidence.
#HERMES_WEBHOOK_URL=
#HERMES_WEBHOOK_AUTH_HEADER=
#HERMES_WEBHOOK_AUTH_VALUE=
# Drata Custom Connections and Tests.
#HERMES_DRATA_CCT_URL=
#HERMES_DRATA_API_KEY=
